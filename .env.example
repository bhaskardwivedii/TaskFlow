# Copy to server/.env for local development
NODE_ENV=development
PORT=4000

# Local docker mongo (docker compose up mongo) or a MongoDB Atlas SRV string
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow?directConnection=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Calendar used for day/week bucketing in analytics
ANALYTICS_TZ=Asia/Kolkata
